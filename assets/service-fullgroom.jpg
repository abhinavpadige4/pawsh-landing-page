<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#F6E05E;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#6B46C1;stop-opacity:0.15"/>
    </linearGradient>
    <linearGradient id="dogFur" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#D4A574"/>
      <stop offset="100%" style="stop-color:#A0714F"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)" rx="8"/>
  <!-- Grooming table -->
  <rect x="60" y="200" width="280" height="12" fill="#6B46C1" rx="4"/>
  <rect x="80" y="212" width="8" height="60" fill="#4C1D95"/>
  <rect x="312" y="212" width="8" height="60" fill="#4C1D95"/>
  <!-- Dog body -->
  <ellipse cx="200" cy="170" rx="70" ry="40" fill="url(#dogFur)"/>
  <!-- Dog head -->
  <circle cx="260" cy="130" r="35" fill="url(#dogFur)"/>
  <!-- Dog ears -->
  <ellipse cx="240" cy="100" rx="12" ry="20" fill="#8B5E3C" transform="rotate(-15 240 100)"/>
  <ellipse cx="280" cy="100" rx="12" ry="20" fill="#8B5E3C" transform="rotate(15 280 100)"/>
  <!-- Dog eyes -->
  <circle cx="250" cy="125" r="4" fill="#1F2937"/>
  <circle cx="270" cy="125" r="4" fill="#1F2937"/>
  <circle cx="251" cy="124" r="1.5" fill="white"/>
  <circle cx="271" cy="124" r="1.5" fill="white"/>
  <!-- Dog nose -->
  <ellipse cx="260" cy="140" rx="6" ry="4" fill="#1F2937"/>
  <!-- Dog mouth -->
  <path d="M255 145 Q260 152 265 145" stroke="#1F2937" stroke-width="1.5" fill="none"/>
  <!-- Dog tail -->
  <path d="M135 160 Q110 130 120 110" stroke="url(#dogFur)" stroke-width="10" fill="none" stroke-linecap="round"/>
  <!-- Dog legs -->
  <rect x="155" y="195" width="12" height="10" fill="#8B5E3C" rx="3"/>
  <rect x="230" y="195" width="12" height="10" fill="#8B5E3C" rx="3"/>
  <!-- Groomer hand with scissors -->
  <circle cx="100" cy="120" r="15" fill="#FDBCB4"/>
  <rect x="95" y="130" width="10" height="25" fill="#FDBCB4" rx="3"/>
  <!-- Scissors -->
  <line x1="105" y1="155" x2="130" y2="170" stroke="#9CA3AF" stroke-width="2.5"/>
  <line x1="105" y1="155" x2="125" y2="175" stroke="#9CA3AF" stroke-width="2.5"/>
  <circle cx="103" cy="153" r="4" fill="none" stroke="#9CA3AF" stroke-width="2"/>
  <circle cx="107" cy="157" r="4" fill="none" stroke="#9CA3AF" stroke-width="2"/>
  <!-- Sparkles indicating clean/groomed -->
  <text x="160" y="90" font-size="16" fill="#EC4899">✦</text>
  <text x="300" y="80" font-size="12" fill="#EC4899">✦</text>
  <text x="140" y="140" font-size="10" fill="#F6E05E">✦</text>
  <text x="320" y="160" font-size="14" fill="#F6E05E">✦</text>
  <!-- Label -->
  <rect x="120" y="250" width="160" height="30" fill="#6B46C1" rx="15"/>
  <text x="200" y="270" font-family="Poppins, sans-serif" font-size="13" font-weight="600" fill="white" text-anchor="middle">Full Groom</text>
</svg>