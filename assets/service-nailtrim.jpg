<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F6E05E;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#6B46C1;stop-opacity:0.15"/>
    </linearGradient>
    <linearGradient id="paw" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#8B5E3C"/>
      <stop offset="100%" style="stop-color:#6B4226"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)" rx="8"/>
  <!-- Paw pad -->
  <ellipse cx="200" cy="180" rx="70" ry="55" fill="url(#paw)"/>
  <!-- Toe beans -->
  <ellipse cx="155" cy="120" rx="22" ry="28" fill="#8B5E3C"/>
  <ellipse cx="200" cy="105" rx="22" ry="28" fill="#8B5E3C"/>
  <ellipse cx="245" cy="120" rx="22" ry="28" fill="#8B5E3C"/>
  <!-- Nails being trimmed -->
  <path d="M148 95 Q145 80 150 75" stroke="#EC4899" stroke-width="3" fill="none" stroke-linecap="round"/>
  <path d="M193 80 Q190 65 195 60" stroke="#EC4899" stroke-width="3" fill="none" stroke-linecap="round"/>
  <path d="M238 95 Q241 80 236 75" stroke="#EC4899" stroke-width="3" fill="none" stroke-linecap="round"/>
  <!-- Clipper tool -->
  <rect x="280" y="140" width="12" height="50" rx="3" fill="#9CA3AF"/>
  <rect x="276" y="135" width="20" height="12" rx="2" fill="#6B7280"/>
  <rect x="278" y="190" width="16" height="8" rx="2" fill="#4B5563"/>
  <!-- Sparkles -->
  <circle cx="120" cy="70" r="3" fill="#F6E05E"/>
  <circle cx="290" cy="90" r="2.5" fill="#F6E05E"/>
  <circle cx="100" cy="200" r="2" fill="#EC4899"/>
  <circle cx="310" cy="220" r="3" fill="#6B46C1"/>
  <!-- Label -->
  <text x="200" y="270" text-anchor="middle" font-family="Poppins, sans-serif" font-size="16" font-weight="600" fill="#1F2937">Nail Trim</text>
</svg>